# Copier ce fichier en .env (non versionné) puis adapter les valeurs.

# Clé partagée avec le backend Spring Boot (app.ia.api-key) — à changer.
NAFSITI_IA_API_KEY=dev-nafsiti-ia-cle-a-changer

# Modèles à charger au démarrage (séparés par des virgules).
# Valeurs possibles : connexion,matching,sentiment,recommandation,moderation,risque,visage,chatbot
# Retirer un module évite de télécharger ses poids (utile sur une machine peu puissante).
NAFSITI_IA_MODULES=connexion,matching,sentiment,recommandation,moderation,risque,visage,chatbot

# Reconnaissance faciale
FACE_MODELE=Facenet512
FACE_DETECTEUR=opencv
# Distance cosinus maximale pour considérer deux visages identiques (calibrée sur 299 paires : 0.35)
FACE_SEUIL=0.35
# Détection de photo / écran présenté à la caméra (modèle Fasnet, nécessite torch)
FACE_ANTI_SPOOFING=true
